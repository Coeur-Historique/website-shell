---
// website-shell/src/layouts/BaseLayout.astro
// Extrait le 05/08/2026 de myselion4nonprofit (migration multi-repos).
//
// Difference structurelle importante avec l'original monorepo : l'ancien fichier
// definissait en dur, dans son <style is:global>, les 3 couleurs de marque (--brand-*)
// des 8 sites du groupe (:root.theme-charli, :root.theme-eurotys, etc.) -- un contenant
// partage ne peut plus connaitre les couleurs de tous les sites individuellement.
// Remplace par `themeVars` (prop) : le site fournit ses 3 valeurs hex, injectees dans
// un bloc `:root { ... }` genere ici. Chaque repo de contenu n'a donc plus que 3
// valeurs a fournir, pas un bloc CSS entier a dupliquer/maintenir.
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';
import type { ImageMetadata } from 'astro';
import 'bootstrap/dist/css/bootstrap.min.css';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { createTranslator, type Locale, type TranslationDictionary } from '../i18n/engine';
import type { SiteConfig } from '../types';

interface ThemeVars {
  brandDarkBlue: string;
  brandDarkBlueRgb: string; // ex: "11, 26, 43" -- pour rgba() dans les classes utilitaires
  brandRed: string;
  brandRedRgb: string;
  brandBurgundy: string;
}

interface Props {
  siteConfig: SiteConfig;
  translations: TranslationDictionary;
  lang: Locale;
  themeVars: ThemeVars;
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: string;
  publishedAt?: string;
  logoSrc?: ImageMetadata;
  showVolontariatCta?: boolean;
  blogEntryLocales?: Set<Locale> | null;
  translatedPaths: readonly string[];
}

const {
  siteConfig, translations, lang, themeVars,
  title, description, image, canonical, type = 'website', publishedAt,
  logoSrc, showVolontariatCta, blogEntryLocales, translatedPaths,
} = Astro.props;

const currentPathname = Astro.url.pathname;
const canonicalURL = canonical ?? new URL(currentPathname, Astro.site || siteConfig.domain).toString();
const finalImageUrl = image ?? siteConfig.ogImageUrl;

const gaId = siteConfig.analytics?.gaMeasurementId;
const gaEnabled = !!gaId;
const adsId = siteConfig.analytics?.googleAdsId;
const adsEnabled = gaEnabled && !!adsId;
const gscCode = siteConfig.analytics?.searchConsoleVerification;
const gscEnabled = !!gscCode;
const metaPixelId = siteConfig.analytics?.metaPixelId;
const metaPixelEnabled = !!metaPixelId;
const pinterestTagId = siteConfig.analytics?.pinterestTagId;
const pinterestEnabled = !!pinterestTagId;
---

<!doctype html>
<html lang={lang} class="modern-light-theme">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {gscEnabled && <meta name="google-site-verification" content={gscCode} />}

    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {finalImageUrl && <meta property="og:image" content={finalImageUrl} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {finalImageUrl && <meta name="twitter:image" content={finalImageUrl} />}

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={siteConfig.favicon || "/favicon.svg"} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <style set:html={`:root { --brand-dark-blue: ${themeVars.brandDarkBlue}; --brand-dark-blue-rgb: ${themeVars.brandDarkBlueRgb}; --brand-red: ${themeVars.brandRed}; --brand-red-rgb: ${themeVars.brandRedRgb}; --brand-burgundy: ${themeVars.brandBurgundy}; }`} />

    {gaEnabled && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script define:vars={{ gaId, adsId, adsEnabled }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
          if (adsEnabled) { gtag('config', adsId); }
        </script>
      </>
    )}

    {metaPixelEnabled && (
      <>
        <script define:vars={{ metaPixelId }}>
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', metaPixelId);
          fbq('track', 'PageView');
        </script>
        <noscript>
          <img height="1" width="1" style="display:none" alt=""
            src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`} />
        </noscript>
      </>
    )}

    {pinterestEnabled && (
      <>
        <script define:vars={{ pinterestTagId }}>
          !function(e){if(!window.pintrk){window.pintrk = function () {
          window.pintrk.queue.push(Array.prototype.slice.call(arguments))};var
          n=window.pintrk;n.queue=[],n.version="3.0";var
          t=document.createElement("script");t.async=!0,t.src=e;var
          r=document.getElementsByTagName("script")[0];
          r.parentNode.insertBefore(t,r)}}("https://s.pinimg.com/ct/core.js");
          pintrk('load', pinterestTagId);
          pintrk('page');
        </script>
        <noscript>
          <img height="1" width="1" style="display:none" alt=""
            src={`https://ct.pinterest.com/v3/?event=init&tid=${pinterestTagId}&noscript=1`} />
        </noscript>
      </>
    )}
  </head>
  <body>

    <Header
      siteConfig={siteConfig}
      translations={translations}
      lang={lang}
      currentPathname={currentPathname}
      logoSrc={logoSrc}
      showVolontariatCta={showVolontariatCta}
      blogEntryLocales={blogEntryLocales}
      translatedPaths={translatedPaths}
    />

    <main>
      <slot />
    </main>

    <Footer siteConfig={siteConfig} translations={translations} lang={lang} currentPathname={currentPathname} siteOrigin={Astro.site?.origin} />

    <SpeedInsights />
    <Analytics />

    <script>
      import 'bootstrap/dist/js/bootstrap.bundle.min.js';
    </script>

    {gaEnabled && (
      <script>
        document.addEventListener('click', function (e) {
          const el = e.target.closest('[data-cta-id]');
          if (!el || typeof gtag !== 'function') return;
          gtag('event', 'cta_click', {
            cta_id: el.getAttribute('data-cta-id'),
            page_path: window.location.pathname
          });
        });
      </script>
    )}
  </body>
</html>

<style is:global>
  html, body {
    overflow-x: hidden;
    max-width: 100vw;
  }

  :root {
    --bg-light: #f8f9fa;
    --text-dark-contrast: #111827;
  }

  .modern-light-theme {
    background-color: #ffffff;
    color: var(--text-dark-contrast);
    font-family: system-ui, -apple-system, sans-serif;
  }

  .text-brand-dark { color: var(--brand-dark-blue) !important; }
  .text-brand-red { color: var(--brand-red) !important; }
  .text-brand-burgundy { color: var(--brand-burgundy) !important; }
  .text-high-contrast { color: var(--text-dark-contrast) !important; }

  .text-gradient-brand {
    background: linear-gradient(135deg, var(--brand-red), var(--brand-burgundy));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .bg-brand-dark { background-color: var(--brand-dark-blue); }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    color: #64748b;
    text-decoration: none;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .social-icon [data-icon] {
    width: 1.2em;
    height: 1.2em;
  }
  .social-icon:hover {
    color: var(--brand-red);
    transform: scale(1.1);
  }

  .badge-modern {
    background: rgba(var(--brand-dark-blue-rgb), 0.05);
    color: var(--brand-dark-blue);
    padding: 0.6rem 1.2rem;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .btn-modern {
    padding: 0.8rem 2.5rem;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-primary-modern {
    background: linear-gradient(135deg, var(--brand-red), var(--brand-burgundy));
    color: #fff;
    box-shadow: 0 4px 15px rgba(var(--brand-red-rgb), 0.2);
    border: none;
  }
  .btn-primary-modern:hover {
    background: var(--brand-burgundy);
    transform: translateY(-2px);
    color: #fff;
  }

  .btn-outline-modern {
    background: transparent;
    color: var(--brand-dark-blue);
    border: 2px solid var(--brand-dark-blue);
  }
  .btn-outline-modern:hover {
    background: rgba(var(--brand-dark-blue-rgb), 0.05);
    transform: translateY(-2px);
  }

  .responsive-centered-image {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
    border-radius: 2rem;
    border: 8px solid white;
  }

  .clean-card {
    transition: all 0.3s ease-in-out;
  }
  .clean-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08) !important;
  }

  .card-img-modern {
    width: 100px;
    height: 100px;
    object-fit: cover;
    margin: 0 auto;
    display: block;
    border: 4px solid var(--bg-light);
  }

  .cta-section {
    background: linear-gradient(135deg, var(--brand-dark-blue), var(--brand-burgundy));
  }

  .hover-scale:hover {
    transform: scale(1.03);
  }
  .hover-text-red:hover {
    color: var(--brand-red) !important;
  }
</style>
